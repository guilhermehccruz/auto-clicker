<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="auto-clicker"
        Arguments=""
        InstallLocation="C:\Program Files\auto-clicker\Auto Clicker">
    </Installer>
    <PackageInformation
        PackageName="Auto Clicker"
        PackageDisplayName="Auto Clicker"
        PublisherName="CN=auto-clicker"
        PublisherDisplayName="auto-clicker"
        Version="0.1.0.0"
        PackageDescription="A single-purpose autoclicker for repetitive clicking">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="auto-clicker"
                Description="A single-purpose autoclicker for repetitive clicking"
                DisplayName="Auto Clicker"
                ExecutableName="auto-clicker"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Auto Clicker</DisplayName>
            <PublisherDisplayName>auto-clicker</PublisherDisplayName>
            <Description>A single-purpose autoclicker for repetitive clicking</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="auto-clicker.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
